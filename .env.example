# Copy to .env and fill in what you use. Every block is optional: the app runs
# with whatever is configured and tells you what is missing under Connections.
# Check any time with:  ./dealflow.sh doctor

# --- You ---------------------------------------------------------------------
# Used to tell your messages from theirs (email From address, LinkedIn export).
OWNER_NAME=
OWNER_EMAILS=            # comma-separated, include aliases

# --- Sorting: Jev through OpenRouter ------------------------------------------
# Key from https://openrouter.ai/keys . Without it, sorting falls back to
# simple keyword rules.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14          # or ~typesafe/jev-latest
# Jev returns decisions, not text. Optional: any chat model slug from
# openrouter.ai/models for one-line briefs and reply drafts. Leave blank to skip.
WRITER_MODEL=
TRIAGE_CONCURRENCY=4

# --- Instagram (official API, read-only use) ---------------------------------
# Meta app dashboard > Instagram > API setup. The app detects the token type:
#   EAA...  "Unified login" (Business Integration System User token): also set
#           INSTAGRAM_USER_ID to your Instagram account ID (starts with 1784).
#           Permissions: instagram_basic, instagram_manage_messages.
#   IGAA... "Instagram login": leave INSTAGRAM_USER_ID blank. Renewed weekly.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_LABEL=                     # optional name shown in the inbox
# More Instagram accounts (up to 8): number them.
# INSTAGRAM_2_ACCESS_TOKEN=
# INSTAGRAM_2_USER_ID=
# INSTAGRAM_2_LABEL=Brand
INSTAGRAM_API_VERSION=v27.0
INSTAGRAM_MAX_CONVERSATIONS=200

# --- Gmail ---------------------------------------------------------------------
# Each account connects one of two ways.
#
# 1. Sign in with Google (recommended: read-only scope, no password stored).
#    Your own OAuth client from Google Cloud (type Desktop app, Gmail API
#    enabled; see the README). Then press "Sign in with Google" per account
#    in Settings > Gmail: it fills in GMAIL_ADDRESS and GMAIL_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=                    # ....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
#
# 2. IMAP with an app password: the address and 16 characters from
#    https://myaccount.google.com/apppasswords (needs 2-Step Verification).
#    Never your Google account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=                         # optional name shown in the inbox
# GMAIL_REFRESH_TOKEN=               # written by Sign in with Google; do not type one in
# More Gmail accounts (up to 8): number them.
# GMAIL_2_ADDRESS=
# GMAIL_2_APP_PASSWORD=              # or GMAIL_2_REFRESH_TOKEN, from Sign in with Google
# GMAIL_2_LABEL=Personal
GMAIL_LOOKBACK_DAYS=30               # how far back the first sync reaches
GMAIL_PRIMARY_ONLY=false             # true = skip Promotions, Social, Updates, Forums
GMAIL_SYNC_SENT=true                 # read sent mail to know what you answered
GMAIL_MAILBOXES=INBOX                # comma-separated; a label is a mailbox

# --- Proton Mail: Bridge (IMAP on this machine) ------------------------------
# From Bridge > your account > Mailbox details. Use the BRIDGE password, not
# your Proton password. Bridge may pick a port above 1143: copy what it shows.
PROTON_USERNAME=
PROTON_BRIDGE_PASSWORD=
PROTON_IMAP_PORT=1143
PROTON_IMAP_SECURITY=starttls        # or ssl, if you changed it in Bridge
# Bridge > Settings > Advanced settings > Export TLS certificates, then point
# this at cert.pem. Required: it is the only certificate the app will trust.
PROTON_CERT_PATH=
PROTON_MAILBOXES=INBOX               # comma-separated, e.g. INBOX,Folders/Deals
PROTON_SENT_MAILBOX=Sent             # blank to skip your sent mail
PROTON_LOOKBACK_DAYS=30              # how far back the first sync reaches

# --- LinkedIn ----------------------------------------------------------------
# No credentials here. Press Connect LinkedIn under Settings and sign in on
# LinkedIn's own page; after that it is read in your browser each time you
# press Sync, never on the timer. LinkedIn's terms prohibit automated access,
# so using it is your call. (Claude can also collect it: collectors/linkedin-sync.md.)
LINKEDIN_OPEN_THREADS=5              # conversations opened per sync for earlier messages; 0 = the inbox list only
LINKEDIN_BROWSER_VISIBLE=true        # show the browser window while it syncs
LINKEDIN_OPEN_UNREAD=false           # true also opens unread ones, which marks them read on LinkedIn
LINKEDIN_BROWSER_PATH=               # blank = first of Chrome, Chromium, Brave, Edge found
LINKEDIN_STALE_HOURS=24              # hours before the app calls the data stale

# --- App ---------------------------------------------------------------------
DEALFLOW_PORT=4747
SYNC_INTERVAL_MINUTES=15             # 0 = only sync when you press Sync
AUTO_TRIAGE=true
